{
  "name": "soundcloud-electron-client",
  "version": "1.0.0",
  "description": "Desktop SoundCloud client built with Electron",
  "main": "src/main/main.js",
  "author": "erdboyz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "rebuild": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "better-sqlite3": "^11.8.1",
    "electron-store": "^10.0.1",
    "sanitize-filename": "^1.6.3",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.erdboyz.soundclouddesktop",
    "productName": "SoundCloud Desktop",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "bin",
        "filter": [
          "yt-dlp.exe"
        ]
      }
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
